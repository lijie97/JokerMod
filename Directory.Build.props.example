<Project>
    <PropertyGroup>
        <!-- MegaDot / Godot 4.5.1 mono executable used for export-pack when publishing. -->
        <!-- The game will not load a .pck exported with a newer Godot version. -->
        <GodotPath>C:/path/to/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>

        <!-- If Slay the Spire 2 is not found automatically, uncomment and set the install directory. -->
        <!-- <Sts2Path>C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path> -->
    </PropertyGroup>
</Project>
